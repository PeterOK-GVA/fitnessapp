# Default: text auto-detected, normalised to LF on commit.
* text=auto eol=lf

# Windows-only scripts keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Unix scripts force LF (avoids CRLF breaking shebang on Linux CI)
gradlew text eol=lf
*.sh text eol=lf

# Binaries
*.jar binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.apk binary
*.aab binary
*.keystore binary
*.jks binary
